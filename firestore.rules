rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userEmail) {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == userEmail.lower()) ||
        request.auth.uid == userEmail
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'saeed.samadelivery@gmail.com')
      );
    }

    // 1. Limowin Platform Settings (Site name, Gateways, Deposit Bonuses, Hero Banners)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Users Collection (Players & Admins)
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 3. Deposits Collection
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // 4. Withdrawals Collection
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // 5. Promotions Collection
    match /promotions/{promoId} {
      allow read, write: if true;
    }

    // 6. Game History & Bets
    match /gameHistory/{historyId} {
      allow read, write: if true;
    }

    // 7. Per-User Live VIP Support Messages
    match /supportMessages/{messageId} {
      allow read, write: if true;
    }

    // Catch-all for platform collections & subcollections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
